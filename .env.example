# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your-bucket
R2_PUBLIC_URL=https://your-cdn-domain.com

# 登录密码
AUTH_PASSWORD=change-me

# 多账号配置文件（可选，默认 ./data/accounts.json；Docker 部署记得挂载 ./data 卷）
# ACCOUNTS_FILE=./data/accounts.json

# Cookie 签名密钥（可选，不填则从密码派生；多实例部署建议显式设置）
# AUTH_SECRET=some-random-string

# MCP 只读服务（可选，外部 Agent 接入；建议 openssl rand -hex 32 生成，不配则 /mcp 端点关闭）
# MCP_TOKEN=some-random-hex

PORT=3000
